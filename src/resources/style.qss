/* ==========================================================
   OmniVoice Cloner — Dark Theme
   ========================================================== */

/* --- Global --- */
QWidget {
    background-color: #1e1e2e;
    color: #cdd6f4;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 13px;
}

QMainWindow {
    background-color: #1e1e2e;
}

/* --- Group Boxes --- */
QGroupBox {
    background-color: #282840;
    border: 1px solid #3b3b5c;
    border-radius: 8px;
    margin-top: 16px;
    padding: 16px;
    font-weight: bold;
    font-size: 13px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 2px 10px;
    color: #89b4fa;
}

/* --- Labels --- */
QLabel {
    background: transparent;
    color: #bac2de;
}

QLabel#lbl_model_status {
    font-size: 13px;
    font-weight: bold;
}

QLabel#lbl_progress {
    color: #a6adc8;
    font-size: 12px;
}

QLabel#lbl_time {
    color: #a6adc8;
    font-size: 11px;
}

QLabel#drop_label {
    color: #6c7086;
    font-size: 13px;
}

/* --- Buttons --- */
QPushButton {
    background-color: #45475a;
    color: #cdd6f4;
    border: 1px solid #585b70;
    border-radius: 6px;
    padding: 7px 14px;
    font-size: 13px;
    min-height: 34px;
}

QPushButton:hover {
    background-color: #585b70;
    border-color: #89b4fa;
}

QPushButton:pressed {
    background-color: #313244;
}

QPushButton:disabled {
    background-color: #313244;
    color: #585b70;
    border-color: #3b3b5c;
}

QPushButton#btn_primary {
    background-color: #89b4fa;
    color: #1e1e2e;
    font-weight: bold;
    font-size: 14px;
    border: none;
    padding: 8px 22px;
}

QPushButton#btn_primary:hover {
    background-color: #74c7ec;
}

QPushButton#btn_primary:pressed {
    background-color: #89dceb;
}

QPushButton#btn_primary:disabled {
    background-color: #45475a;
    color: #585b70;
}

QPushButton#btn_secondary {
    background-color: #313244;
    border: 1px solid #45475a;
}

QPushButton#btn_secondary:hover {
    background-color: #45475a;
    border-color: #89b4fa;
}

QPushButton#btn_danger {
    background-color: #f38ba8;
    color: #1e1e2e;
    border: none;
    font-weight: bold;
    padding: 7px 18px;
}

QPushButton#btn_danger:hover {
    background-color: #eba0ac;
}

QPushButton#btn_play {
    background-color: transparent;
    color: #a6e3a1;
    border: none;
    border-radius: 4px;
    font-size: 20px;
    font-weight: bold;
    padding: 2px 6px;
}

QPushButton#btn_play:hover {
    background-color: #313244;
    color: #94e2d5;
}

/* --- Text Inputs --- */
QLineEdit {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 7px 10px;
    min-height: 34px;
    selection-background-color: #89b4fa;
    selection-color: #1e1e2e;
}

QLineEdit:focus {
    border-color: #89b4fa;
}

QPlainTextEdit {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 8px;
    selection-background-color: #89b4fa;
    selection-color: #1e1e2e;
}

QPlainTextEdit:focus {
    border-color: #89b4fa;
}

/* --- Sliders --- */
QSlider::groove:horizontal {
    height: 6px;
    background: #45475a;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #89b4fa;
    width: 16px;
    height: 16px;
    margin: -5px 0;
    border-radius: 8px;
}

QSlider::handle:horizontal:hover {
    background: #74c7ec;
}

QSlider::sub-page:horizontal {
    background: #89b4fa;
    border-radius: 3px;
}

/* --- Combo Box --- */
QComboBox {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 6px 10px;
    min-height: 34px;
}

QComboBox:hover {
    border-color: #89b4fa;
}

QComboBox::drop-down {
    border: none;
    width: 24px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid #89b4fa;
    margin-right: 8px;
}

QComboBox QAbstractItemView {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    padding: 4px;
    outline: 0;
    selection-background-color: #45475a;
    selection-color: #cdd6f4;
}

QComboBox QAbstractItemView::item {
    min-height: 30px;
    padding: 6px 10px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:selected {
    background-color: #45475a;
    color: #cdd6f4;
}

/* --- Progress Bar --- */
QProgressBar {
    background-color: #313244;
    border: 1px solid #45475a;
    border-radius: 4px;
    text-align: center;
    color: #cdd6f4;
    font-size: 11px;
}

QProgressBar::chunk {
    background-color: #89b4fa;
    border-radius: 3px;
}

/* --- Status Bar --- */
QStatusBar {
    background-color: #181825;
    color: #a6adc8;
    font-size: 12px;
    border-top: 1px solid #313244;
}

/* --- Drop Area --- */
QWidget#drop_area {
    background-color: #313244;
    border: 2px dashed #45475a;
    border-radius: 8px;
}

QWidget#drop_area[hover="true"] {
    border-color: #89b4fa;
    background-color: #1e1e3a;
}

/* --- Scrollbar --- */
QScrollBar:vertical {
    background: #1e1e2e;
    width: 8px;
    border: none;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: #45475a;
    border-radius: 4px;
    min-height: 20px;
}

QScrollBar::handle:vertical:hover {
    background: #585b70;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #1e1e2e;
    height: 8px;
    border: none;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: #45475a;
    border-radius: 4px;
    min-width: 20px;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0;
    background: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* Corner widget between vertical and horizontal scrollbars */
QAbstractScrollArea::corner {
    background: #1e1e2e;
    border: none;
}

/* --- Dialog Controls --- */
QDialog#advanced_settings_dialog {
    background-color: #1e1e2e;
}

QDialog#advanced_settings_dialog QGroupBox {
    border-color: #45475a;
}

QDialog#advanced_settings_dialog QSpinBox {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 6px;
    padding: 6px 8px;
    min-height: 34px;
}

QDialog#advanced_settings_dialog QSpinBox:focus {
    border-color: #89b4fa;
}

QDialog#advanced_settings_dialog QSpinBox::up-button,
QDialog#advanced_settings_dialog QSpinBox::down-button {
    width: 20px;
    border: none;
    background: transparent;
}

QDialog#advanced_settings_dialog QRadioButton#dialog_radio {
    spacing: 8px;
    min-height: 28px;
    color: #cdd6f4;
    background-color: transparent;
    border: none;
}

QDialog#advanced_settings_dialog QRadioButton#dialog_radio::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 1px solid #6c7086;
    background: #313244;
}

QDialog#advanced_settings_dialog QRadioButton#dialog_radio::indicator:checked {
    border-color: #89b4fa;
    background: #89b4fa;
}

QDialog#advanced_settings_dialog QRadioButton#dialog_radio::indicator:unchecked {
    background: #313244;
}

QDialog#advanced_settings_dialog QGroupBox QLabel {
    background-color: transparent;
}

/* --- Tooltips --- */
QToolTip {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 4px 8px;
}

/* --- Sidebar --- */
QWidget#sidebar {
    background-color: #181825;
    border-right: 1px solid #313244;
}

QLabel#sidebar_title {
    color: #89b4fa;
    font-size: 16px;
    font-weight: bold;
    padding: 4px 8px;
    background: transparent;
}

QLabel#sidebar_logo {
    background: transparent;
    padding: 4px;
}

QLabel#sidebar_version {
    color: #585b70;
    font-size: 11px;
    background: transparent;
}

QPushButton#sidebar_btn {
    background-color: transparent;
    color: #a6adc8;
    border: none;
    border-radius: 8px;
    padding: 10px 12px;
    text-align: left;
    font-size: 13px;
    min-height: 24px;
}

QPushButton#sidebar_btn:hover {
    background-color: #313244;
    color: #cdd6f4;
}

QPushButton#sidebar_btn:checked {
    background-color: #89b4fa;
    color: #1e1e2e;
    font-weight: bold;
}

/* --- Model Bar --- */
QWidget#model_bar {
    background-color: #181825;
    border: 1px solid #313244;
    border-radius: 8px;
}

/* --- Table Widget --- */
QTableWidget {
    background-color: #1e1e2e;
    alternate-background-color: #282840;
    gridline-color: #313244;
    border: 1px solid #3b3b5c;
    border-radius: 6px;
    selection-background-color: #45475a;
    selection-color: #cdd6f4;
}

QTableWidget::item {
    padding: 4px 8px;
}

QHeaderView::section {
    background-color: #282840;
    color: #89b4fa;
    border: none;
    border-bottom: 2px solid #3b3b5c;
    padding: 6px 8px;
    font-weight: bold;
    font-size: 12px;
}

/* --- Table Action Buttons --- */
QPushButton#btn_table_action {
    background-color: #313244;
    color: #cdd6f4;
    border: 1px solid #45475a;
    border-radius: 4px;
    padding: 2px 10px;
    font-size: 12px;
    min-height: 24px;
    min-width: 40px;
    qproperty-flat: false;
}

QPushButton#btn_table_action:hover {
    background-color: #45475a;
    border-color: #89b4fa;
}

QPushButton#btn_table_danger {
    background-color: #f38ba8;
    color: #1e1e2e;
    border: none;
    border-radius: 4px;
    padding: 2px 10px;
    font-size: 12px;
    font-weight: bold;
    min-height: 24px;
    min-width: 40px;
}

QPushButton#btn_table_danger:hover {
    background-color: #eba0ac;
}

/* --- Stacked Widget --- */
QStackedWidget {
    background: transparent;
}

/* --- Log Panel --- */
QWidget#log_panel {
    background-color: #181825;
    border-left: 1px solid #313244;
}

QPlainTextEdit#log_text {
    background-color: #11111b;
    color: #a6adc8;
    border: 1px solid #313244;
    border-radius: 6px;
    padding: 6px;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 10px;
    selection-background-color: #45475a;
    selection-color: #cdd6f4;
}
